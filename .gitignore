# ignore everything in the root except the "wp-content" directory and the outher no-wordpress folders.
/*
!wp-content/


# ignore everything in the "wp-content" directory, except:
# mu-plugins, plugins, languages and themes directories
wp-content/*
!wp-content/mu-plugins/
!wp-content/plugins/
!wp-content/themes/
!wp-content/languages/


# ignore all mu-plugins, plugins, languages and themes
# unless explicitly whitelisted at the end of this file
wp-content/mu-plugins/*
wp-content/plugins/*
wp-content/themes/*
wp-content/languages/*
!wp-content/languages/themes/
wp-content/languages/themes/*

# ignore all files starting with . or ~
.*
~*

# ignore node dependency directories
node_modules/
dist/

# ignore OS generated files
ehthumbs.db
Thumbs.db
.Trashes

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ignore files that a local computer might use for its own convenience
.DS_Store
*.swp
*.pyc



# local build tools
.vagrant
.idea
*.sassc
*.scssc
*.codekit
*.sh
*.orig

# Ignore potentially dangerous files (dependabot alerts)
yarn.lock
package-lock.json

# -------------------------
# BEGIN Whitelisted Files
# -------------------------

# track these files, if they exist
!.gitignore
!.editorconfig
!.phpcs.xml.dist
!README.md
!CHANGELOG.md
!composer.json
# Migration file
#!*.sql.gz

# track favicon files, if they exist
!android-chrome-*.png
!apple-touch-icon*.png
!browserconfig.xml
!favicon*.png
!favicon*.ico
!manifest.json
!mstile-*.png
!safari-pinned-tab.svg
!site.webmanifest


# track these mu-plugins and/or plugins
!wp-content/mu-plugins/index.php
!wp-content/mu-plugins/sadoje

!wp-content/plugins/cg-woo-grid
!wp-content/plugins/sadoje-template
!wp-content/plugins/woo-color-importer

# Ignore build folders of plugin
wp-content/mu-plugins/sadoje/.babelrc
wp-content/mu-plugins/sadoje/node_modules/
wp-content/mu-plugins/sadoje/dist
wp-content/mu-plugins/sadoje/dist-product
wp-content/mu-plugins/sadoje/npm-debug.log
wp-content/mu-plugins/sadoje/vendor

wp-content/plugins/cg-woo-grid/.babelrc
wp-content/plugins/cg-woo-grid/node_modules/
wp-content/plugins/cg-woo-grid/dist
wp-content/plugins/cg-woo-grid/dist-product
wp-content/plugins/cg-woo-grid/npm-debug.log
wp-content/plugins/cg-woo-grid/vendor

# Ignore compiled files
wp-content/mu-plugins/sadoje/admin/js/sadoje.*
wp-content/mu-plugins/sadoje/admin/css/sadoje.*
wp-content/mu-plugins/sadoje/public/js/sadoje.*
wp-content/mu-plugins/sadoje/public/css/sadoje.*

wp-content/plugins/cg-woo-grid/admin/js/cg-woo-grid-admin.*
wp-content/plugins/cg-woo-grid/admin/css/cg-woo-grid-admin.*
wp-content/plugins/cg-woo-grid/public/js/cg-woo-grid.*
wp-content/plugins/cg-woo-grid/public/css/cg-woo-grid.*

# Ignore potentially dangerous files (dependabot alerts)
wp-content/plugins/cg-woo-grid/yarn.lock

# track these translations
!wp-content/languages/themes/cartify-es_ES.mo
!wp-content/languages/themes/cartify-es_ES.po

# track these themes
!wp-content/themes/sadoje/

