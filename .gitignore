# .gitignore template for WordPress + Sage projects (gitignore.wordpress.example): new-wp-sage.sh replaces codigo with the theme folder name.

# ignore everything in the root except the  files and folders specified below
/*

# ignore all files starting with . or ~
.*
~*

# ignore node dependency directories
node_modules/
dist/

# ignore OS generated files
ehthumbs.db
Thumbs.db
.Trashes

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ignore files that a local computer might use for its own convenience
.DS_Store
*.swp
*.pyc



# local build tools
.vagrant
.idea
*.sassc
*.scssc
*.codekit
*.sh
*.orig

# Ignore potentially dangerous files (dependabot alerts)
yarn.lock
#package-lock.json


# Ignore builder files and folders
/node_modules
/vendor
/public/*
/.env
/.budfiles
/npm-debug.log
/yarn-error.log
/yarn.lock
#/package-lock.json
/composer.lock
#/theme.json


# -------------------------
# SSL
# -------------------------

# Ignore SSL certificates
/certs
/certs/*
*.pem


# -------------------------
# Logs
# -------------------------

# Ignore logs
/logs
/logs/*
*.log

# -------------------------
# Wordpress
# -------------------------

# Track the "wordpress" directory and the outher no-wordpress folders.
!wordpress

# ignore everything in the "wordpress" directory, except "wp-content"
wordpress/*
!wordpress/wp-content/


# ignore everything in the "wp-content" directory, except:
# mu-plugins, plugins, and themes directories
wordpress/wp-content/*
!wordpress/wp-content/mu-plugins/
!wordpress/wp-content/plugins/
!wordpress/wp-content/themes/

# ignore all mu-plugins, plugins, and themes
# unless explicitly whitelisted at the end of this file
wordpress/wp-content/mu-plugins/*
wordpress/wp-content/plugins/*
wordpress/wp-content/themes/*



# -------------------------
# BEGIN Whitelisted Files
# -------------------------

# track these files, if they exist
!.gitignore
!.editorconfig
!.phpcs.xml.dist
!composer.json
!theme.json
# Migration file
!*.sql.gz

# Markdown files
!README.md
!CHANGELOG.md

# Docs
!docs/

# per-component exclusions for bin/release.sh
!.distignore
# track example files, if they exist
!*.example

# track staging files, if they exist
!*.staging

# track favicon files, if they exist
!android-chrome-*.png
!apple-touch-icon*.png
!browserconfig.xml
!favicon*.png
!favicon*.ico
!manifest.json
!mstile-*.png
!safari-pinned-tab.svg
!site.webmanifest

# Docker
!docker-compose.yml
# Deployment scripts (bin/*.sh would be ignored by *.sh above)
!bin/
!bin/*.sh
bin/deploy.env
!docker-compose.remote.yml
!Caddyfile
!docker
!nginx.conf.production
!uploads.ini

# Wordpress: track these mu-plugins, plugins, and themes
!wp-config.php

# WPML Plugin: These files were updated to prevent fatal errors caused by incompatibilities between the WPML plugin and SAGE
#!wordpress/wp-content/plugins/wpml-string-translation/

# track these mu-plugins and/or plugins

!wordpress/wp-content/plugins/sadoje
!wordpress/wp-content/plugins/cg-woo-grid
!wordpress/wp-content/plugins/sadoje-template
!wordpress/wp-content/plugins/woo-color-importer
!wordpress/wp-content/plugins/cpt-easy

# Ignore build folders of plugin
wordpress/wp-content/plugins/sadoje/.babelrc
wordpress/wp-content/plugins/sadoje/node_modules/
wordpress/wp-content/plugins/sadoje/dist
wordpress/wp-content/plugins/sadoje/dist-product
wordpress/wp-content/plugins/sadoje/npm-debug.log
wordpress/wp-content/plugins/sadoje/vendor

wordpress/wp-content/plugins/cg-woo-grid/.babelrc
wordpress/wp-content/plugins/cg-woo-grid/node_modules/
wordpress/wp-content/plugins/cg-woo-grid/dist
wordpress/wp-content/plugins/cg-woo-grid/dist-product
wordpress/wp-content/plugins/cg-woo-grid/npm-debug.log
wordpress/wp-content/plugins/cg-woo-grid/vendor
wordpress/wp-content/plugins/cpt-easy/vendor
wordpress/wp-content/plugins/cpt-easy/composer.lock
wordpress/wp-content/plugins/cpt-easy/.phpunit.cache
wordpress/wp-content/plugins/cpt-easy/.phpunit.result.cache

# Ignore compiled files
wordpress/wp-content/plugins/sadoje/admin/js/sadoje.*
wordpress/wp-content/plugins/sadoje/admin/css/sadoje.*
wordpress/wp-content/plugins/sadoje/public/js/sadoje.*
wordpress/wp-content/plugins/sadoje/public/css/sadoje.*

wordpress/wp-content/plugins/cg-woo-grid/admin/js/cg-woo-grid-admin.*
wordpress/wp-content/plugins/cg-woo-grid/admin/css/cg-woo-grid-admin.*
wordpress/wp-content/plugins/cg-woo-grid/public/js/cg-woo-grid.*
wordpress/wp-content/plugins/cg-woo-grid/public/css/cg-woo-grid.*

# Ignore potentially dangerous files (dependabot alerts)
wordpress/wp-content/plugins/cg-woo-grid/yarn.lock

# track these translations
!wordpress/wp-content/languages/themes/cartify-es_ES.mo
!wordpress/wp-content/languages/themes/cartify-es_ES.po


# Theme
!wordpress/wp-content/themes/sadoje/

# Ignore dist folder of theme
wordpress/wp-content/themes/sadoje/dist
# Ignore development Files
wordpress/wp-content/themes/sadoje/node_modules
wordpress/wp-content/themes/sadoje/vendor
wordpress/wp-content/themes/sadoje/.env
wordpress/wp-content/themes/sadoje/.budfiles
wordpress/wp-content/themes/sadoje/npm-debug.log
wordpress/wp-content/themes/sadoje/yarn-error.log
wordpress/wp-content/themes/sadoje/yarn.lock
#wordpress/wp-content/themes/sadoje/package-lock.json
#wordpress/wp-content/themes/sadoje/composer.lock
#wordpress/wp-content/themes/sadoje/theme.json

