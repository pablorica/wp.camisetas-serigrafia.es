# ignore everything in the root except the "wp-content" directory and the outher no-wordpress folders.
/*
!wp-content/


# ignore everything in the "wp-content" directory, except:
# mu-plugins, plugins, and themes directories
wp-content/*
!wp-content/mu-plugins/
!wp-content/plugins/
!wp-content/themes/

# ignore all mu-plugins, plugins, and themes
# unless explicitly whitelisted at the end of this file
wp-content/mu-plugins/*
wp-content/plugins/*
wp-content/themes/*


# ignore all files starting with . or ~
.*
~*

# ignore node dependency directories
node_modules/
dist/

# ignore OS generated files
ehthumbs.db
Thumbs.db
.Trashes

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ignore files that a local computer might use for its own convenience
.DS_Store
*.swp
*.pyc



# local build tools
.vagrant
.idea
*.sassc
*.scssc
*.codekit
*.sh
*.orig

# Ignore potentially dangerous files (dependabot alerts)
yarn.lock 
package-lock.json

# -------------------------
# BEGIN Whitelisted Files
# -------------------------

# track these files, if they exist
!.gitignore
!.editorconfig
!.phpcs.xml.dist
!README.md
!CHANGELOG.md
!composer.json
# Migration file
!*.sql.gz

# track favicon files, if they exist
!android-chrome-*.png
!apple-touch-icon*.png
!browserconfig.xml
!favicon*.png
!favicon*.ico
!manifest.json
!mstile-*.png
!safari-pinned-tab.svg
!site.webmanifest


# track these mu-plugins and/or plugins
#!wp-content/plugins/theme-customisations-master
#!wp-content/plugins/cg-woo-grid

# track these themes
!wp-content/themes/codigo/

# Ignore build folders of theme
wp-content/themes/codigo/.gitignore
wp-content/themes/codigo/.sass-cache
wp-content/themes/codigo/bower_components
wp-content/themes/codigo/node_modules
wp-content/themes/codigo/*.zip
wp-content/themes/codigo/dist
wp-content/themes/codigo/dist-product
wp-content/themes/codigo/npm-debug.log
wp-content/themes/codigo/vendor/

# Ignore compiled files
wp-content/themes/codigo/js/child-theme.*
wp-content/themes/codigo/css/child-theme.*
wp-content/themes/codigo/css/custom-editor-style.*

# Ignore potentially dangerous files (dependabot alerts)
wp-content/themes/codigo/yarn.lock 
