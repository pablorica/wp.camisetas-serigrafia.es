# .env — PRODUCTION (/srv/docker/wordpress/.env)
# Same keys as local; only the values differ.

PROJECT_NAME=camisetasparatodos
COMPOSE_PROFILES=             # empty: no node, no caddy (host Nginx is the proxy)
APP_ENV=production

# --- MySQL ---
MYSQL_DATABASE=wordpress      # keep the current production values
MYSQL_USER=wpuser
MYSQL_PASSWORD=__new__         # rotate: the new volume creates the users from these
MYSQL_ROOT_PASSWORD=__new__

# --- WordPress ---
WORDPRESS_PORT=8090           # Nginx proxy_pass http://127.0.0.1:8090 (unchanged)
WORDPRESS_SSL_PORT=443        # informational in production; WP_HOME is used as-is
WORDPRESS_TABLE_PREFIX=wp_    # confirm in MIGRATION.md step P1
WORDPRESS_HOME=https://camisetasparatodos.es   # NO trailing slash
WORDPRESS_DEBUG=false
WORDPRESS_CACHE=true          # NitroPack page cache
ACF_PRO_LICENSE=__set_if_you_have_it__

# --- WordPress salts: NEW values (the old ones were readable by the attacker) ---
# Generate: curl -s https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY='__new__'
WORDPRESS_SECURE_AUTH_KEY='__new__'
WORDPRESS_LOGGED_IN_KEY='__new__'
WORDPRESS_NONCE_KEY='__new__'
WORDPRESS_AUTH_SALT='__new__'
WORDPRESS_SECURE_AUTH_SALT='__new__'
WORDPRESS_LOGGED_IN_SALT='__new__'
WORDPRESS_NONCE_SALT='__new__'

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8091          # Nginx /phpmyadmin/ -> http://127.0.0.1:8091 (unchanged)
