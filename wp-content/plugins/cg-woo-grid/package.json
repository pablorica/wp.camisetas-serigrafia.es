{
  "name": "cg-woo-grid",
  "version": "0.0.1",
  "description": "Adds a matrix of Woocommerce Products variations",
  "scripts": {
    "test": "rollup -c src/build/rollup.config.js",
    "js": "npm-run-all js-compile js-minify",
    "js-compile": "rollup --config src/build/rollup.config.js --sourcemap",
    "js-minify": "terser --config-file src/build/terser.config.json --output public/js/cg-woo-grid.min.js public/js/cg-woo-grid.js"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "wordpress",
    "woocommerce",
    "grid",
    "product",
    "attributes"
  ],
  "author": "Pablo Rica (http://codigo.co.uk/pablo-rica)",
  "license": "GPL-2.0",
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/preset-env": "^7.19.4",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^21.0.0",
    "@rollup/plugin-node-resolve": "^13.0.6",
    "npm-run-all": "^4.1.5",
    "rollup": "^2.79.1",
    "terser": "^5.15.1"
  }
}
