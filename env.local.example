# .env — LOCAL development
# Copy to .env. Keep your current passwords and salts; only the structure changed.

PROJECT_NAME=camisetasparatodos
COMPOSE_PROFILES=local        # local = Caddy. Use local,node to also run the node watcher
APP_ENV=local

# --- MySQL ---
MYSQL_DATABASE=camisetasparatodos
MYSQL_USER=pablo
MYSQL_PASSWORD=__keep_yours__
MYSQL_ROOT_PASSWORD=__keep_yours__

# --- WordPress ---
WORDPRESS_PORT=8080           # 127.0.0.1 only; normal access is through Caddy
WORDPRESS_SSL_PORT=8467
WORDPRESS_TABLE_PREFIX=wp_    # must match production (shared database)
WORDPRESS_HOME=https://camisetasparatodos.localhost:8467   # NO trailing slash
WORDPRESS_DEBUG=true
WORDPRESS_CACHE=false         # NitroPack page cache off locally
ACF_PRO_LICENSE=

# --- WordPress salts (local values, different from production) ---
# Generate: curl -s https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY='__keep_yours__'
WORDPRESS_SECURE_AUTH_KEY='__keep_yours__'
WORDPRESS_LOGGED_IN_KEY='__keep_yours__'
WORDPRESS_NONCE_KEY='__keep_yours__'
WORDPRESS_AUTH_SALT='__keep_yours__'
WORDPRESS_SECURE_AUTH_SALT='__keep_yours__'
WORDPRESS_LOGGED_IN_SALT='__keep_yours__'
WORDPRESS_NONCE_SALT='__keep_yours__'

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8567          # 127.0.0.1 only; normal access via https://pma.camisetasparatodos.localhost:8467

# --- Caddy ---
CADDY_HOSTNAME=camisetasparatodos.localhost
CADDY_PRODUCTION_DOMAIN=camisetasparatodos.es

# --- Node (only with COMPOSE_PROFILES=local,node) ---
NODE_PORT=5267
NODE_WORKDIR=wp-content/plugins/your-plugin   # folder with the package.json, relative to ./wordpress

# Removed (now derived from PROJECT_NAME or hardcoded):
# MYSQL_HOST, MYSQL_CONTAINER, WORDPRESS_CONTAINER, PHPMYADMIN_CONTAINER,
# WPCLI_CONTAINER, CADDY_CONTAINER, NODE_CONTAINER,
# WORDPRESS_THEMENAME, VITE_PATH (Sage only)
